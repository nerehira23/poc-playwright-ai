{
  "name": "poc-playwright-ai",
  "version": "1.0.0",
  "description": "Playwright E2E automation framework for SauceDemo with TypeScript, POM, and Allure",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "install:browsers": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "automation",
    "allure",
    "pom"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "allure-js-commons": "^2.6.0",
    "allure-playwright": "^3.0.6",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@faker-js/faker": "^9.2.0",
    "dotenv": "^16.4.5"
  }
}
